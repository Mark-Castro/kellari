# Copy this file to .env.local for local settings.
# Do not commit .env.local or put private values in NEXT_PUBLIC_* variables.

# Canonical public site URL, including https://, when a domain is configured.
NEXT_PUBLIC_SITE_URL=

# Public international-format phone number for the header call link and WhatsApp chat.
# Set to an E.164 number such as +15551234567; leave blank until configured.
NEXT_PUBLIC_CONTACT_PHONE=

# Public firm contact details. Leave unset until verified.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_HEADQUARTERS_ADDRESS=

# Formspree endpoint for website contact inquiries.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xljjlvzv

# Mailchimp hosted signup form. This URL is public and supports double opt-in.
NEXT_PUBLIC_MAILCHIMP_SIGNUP_FORM_URL=

# Official social profile URLs.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Optional browser-facing integrations; leave blank until configured.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Q89L0J6Q1E
NEXT_PUBLIC_GSC_VERIFICATION=

# Strapi CMS. These are server-side variables; never prefix the API token with NEXT_PUBLIC_.
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN= 
# Shared only with Strapi PREVIEW_SECRET; use a random secret outside local development.
STRAPI_PREVIEW_SECRET=
